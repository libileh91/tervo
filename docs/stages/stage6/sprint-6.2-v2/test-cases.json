        "Lancer la suite de tests"
      ],
      "expected_result": {
        "table_intervention": "true",
        "site_id_not_null": "true",
        "equipment_id_nullable": "true",
        "under_warranty_default_false": "true",
        "tests_verts": "true"
      },
      "actual_result": "Validé : tests backend (141 réussis) et migrations PostgreSQL 17.4 pour INT-94–97"
    },
