{
  "$schema": "Stage 6 - Sprint 6.3 Test Cases",
  "sprint": "6.3",
  "description": "Catalogue produits + exposition showroom : modèle métier, API REST, UI minimale",
  "test_cases": [
    {
      "id": "TC-INT-81-01",
      "task": "INT-81",
      "title": "Produits - CRUD API complet",
      "type": "api",
      "preconditions": ["Utilisateur authentifié", "Base migrée"],
      "steps": [
        "POST /api/v1/produits (clim, référence unique)",
        "GET /api/v1/produits/{id}",
        "PUT /api/v1/produits/{id} (changer le prix)",
        "GET /api/v1/produits?categorie=clim",
        "DELETE /api/v1/produits/{id}"
      ],
      "expected_result": {
        "creation_201": "true",
        "lecture_200": "true",
        "mise_a_jour_200": "true",
        "filtre_categorie": "retourne uniquement les clim",
        "suppression_204": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-81-02",
      "task": "INT-81",
      "title": "Produits - contrainte reference unique",
      "type": "api",
      "preconditions": ["Un produit avec reference='CLIM-001' existe"],
      "steps": [
        "POST /api/v1/produits avec reference='CLIM-001'",
        "Observer le code de statut"
      ],
      "expected_result": {
        "statut_http": 409,
        "message_erreur_explicite": "true",
        "aucune_donnee_inseree": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-81-03",
      "task": "INT-81",
      "title": "Produits - pagination et recherche",
      "type": "api",
      "preconditions": ["25 produits en base"],
      "steps": [
        "GET /api/v1/produits?page=1&page_size=10",
        "GET /api/v1/produits?search=pac"
      ],
      "expected_result": {
        "items_retournes": 10,
        "total": 25,
        "pages": 3,
        "recherche_pertinente": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-82-01",
      "task": "INT-82",
      "title": "Exposition - association produit",
      "type": "api",
      "preconditions": ["Un produit existe"],
      "steps": [
        "POST /api/v1/expositions (produit_id, emplacement='Zone A')",
        "GET /api/v1/expositions",
        "Vérifier que le produit est joint"
      ],
      "expected_result": {
        "creation_201": "true",
        "produit_joint_dans_reponse": "true (nom, categorie, prix)",
        "emplacement_conserve": "'Zone A'",
        "un_seul_produit_une_exposition": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-82-02",
      "task": "INT-82",
      "title": "Exposition - essai ≠ vendable",
      "type": "api",
      "preconditions": ["Un produit existe"],
      "steps": [
        "POST exposition avec disponible_essai=true, vendable_showroom=false",
        "GET l'exposition"
      ],
      "expected_result": {
        "disponible_essai": "true (produit essayable)",
        "vendable_showroom": "false (démo uniquement)",
        "les_deux_notions_independantes": "true",
        "modelisation_coherente": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-82-03",
      "task": "INT-82",
      "title": "Exposition - cascade sur suppression produit",
      "type": "integration",
      "preconditions": ["Produit avec exposition associée"],
      "steps": [
        "DELETE /api/v1/produits/{id}",
        "GET /api/v1/expositions"
      ],
      "expected_result": {
        "produit_supprime": "true",
        "exposition_egalement_supprimee": "true (CASCADE)",
        "aucune_exposition_orpheline": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-83-01",
      "task": "INT-83",
      "title": "Frontend - pages catalogue et showroom",
      "type": "e2e",
      "preconditions": ["Utilisateur authentifié", "Produits en base"],
      "steps": [
        "Naviguer vers /produits",
        "Filtrer par catégorie",
        "Naviguer vers /showroom",
        "Ouvrir /produits/{id}"
      ],
      "expected_result": {
        "liste_produits_affichee": "true",
        "filtres_fonctionnels": "true",
        "vue_showroom_par_emplacement": "true",
        "badges_essai_vendable_visibles": "true",
        "fiche_produit_complete": "true",
        "bottom_nav_mise_a_jour": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-83-02",
      "task": "INT-83",
      "title": "Frontend - états loading/empty/error",
      "type": "e2e",
      "preconditions": ["Base vide pour le test empty"],
      "steps": [
        "Charger /produits avec réseau lent → loading",
        "Charger /produits sans données → empty",
        "Couper le backend → error + Réessayer"
      ],
      "expected_result": {
        "loading_skeleton": "visible",
        "empty_message": "visible + action",
        "error_message": "visible + bouton Réessayer",
        "refetch_fonctionnel": "true"
      },
      "actual_result": null
    },
    {
      "id": "TC-INT-84-01",
      "task": "INT-84",
      "title": "Tests - couverture catalogue et exposition",
      "type": "unit",
      "preconditions": ["Suite de tests complète"],
      "steps": [
        "uv run pytest tests/test_produits_api.py -v",
        "uv run pytest tests/test_expositions_api.py -v"
      ],
      "expected_result": {
        "tests_produits_passent": "true",
        "tests_expositions_passent": "true",
        "contrainte_unique_testee": "true",
        "cascade_testee": "true",
        "note_pedagogique_creee": "true"
      },
      "actual_result": null
    }
  ]
}
