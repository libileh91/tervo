{
  "$schema": "Phase 1 - Sprint 1.1 Test Cases",
  "sprint": "1.1",
  "description": "Tests for Auth + Alembic + Client CRUD + Frontend Base",
  "test_cases": [
    {
      "id": "TC-INT-00-01",
      "task": "INT-00",
      "title": "Alembic init + env.py configuration",
      "type": "integration",
      "preconditions": ["Projet FastAPI initialisé", "requirements.txt avec alembic>=1.13"],
      "steps": [
        "Exécuter : alembic init backend/alembic",
        "Configurer env.py avec target_metadata = Base.metadata",
        "Configurer env.py avec DATABASE_URL depuis settings",
        "Créer un modèle vide, générer une migration : alembic revision --autogenerate",
        "Appliquer : alembic upgrade head"
      ],
      "expected_result": {
        "status": "success",
        "alembic_version_table": "créée dans la base",
        "migration_file": "présent dans alembic/versions/",
        "upgrade_head": "OK (no error)"
      },
      "actual_result": {
        "status": "success",
        "alembic_version_table": "créée dans la base (tervo.db)",
                "migration_file": "présent dans alembic/versions/9b55bf942f2a_initial_empty_schema.py",
        "upgrade_head": "OK (no error)",
        "notes": "env.py configuré avec target_metadata=Base.metadata depuis app.models.base et DATABASE_URL depuis app.config.settings. Sync SQLite utilisé (sqlite:///./tervo.db) car Alembic ne supporte pas aiosqlite."
      }
    },
    {
      "id": "TC-INT-01-01",
      "task": "INT-01",
      "title": "Modèle User - création et migration",
      "type": "integration",
      "preconditions": ["Alembic configuré (INT-00)", "Connexion base SQLite"],
      "steps": [
        "Créer models/user.py avec classe User (Base)",
        "Importer dans models/__init__.py",
        "alembic revision --autogenerate -m \"add user table\"",
        "alembic upgrade head",
        "Vérifier la table 'user' dans la base"
      ],
      "expected_result": {
        "table_exists": true,
        "columns": [
          "id",
          "username",
          "email",
          "hashed_password",
          "full_name",
          "role",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "username_unique": true,
        "email_unique": true,
        "role_default": "technician"
      },
      "actual_result": {
        "table_exists": true,
        "columns": [
          "id",
          "username",
          "email",
          "hashed_password",
          "full_name",
          "role",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "username_unique": true,
        "email_unique": true,
        "role_default": "technician",
        "notes": "Migration 24b96d6f9dfa appliquée avec succès. Table 'user' créée (guillemets pour éviter conflit SQL). Enum Role (technician, admin)."
      }
    },
    {
      "id": "TC-INT-02-01",
      "task": "INT-02",
      "title": "POST /auth/login - succès",
      "type": "api",
      "preconditions": [
        "Seed d'un utilisateur : username='tech1', password='password123'",
        "Base de données accessible"
      ],
      "steps": ["POST /api/v1/auth/login", "Body: { \"username\": \"tech1\", \"password\": \"password123\" }"],
      "expected_result": {
        "status_code": 200,
        "body": {
          "access_token": "string (JWT)",
          "refresh_token": "string (JWT)",
          "token_type": "bearer",
          "expires_in": 1800
        },
        "access_token_decoded.sub": "user_id de tech1",
        "access_token_decoded.exp": "now + 30min"
      },
      "actual_result": {
        "status_code": 200,
        "access_token": "JWT valide",
        "refresh_token": "JWT valide",
        "token_type": "bearer",
        "expires_in": 1800
      }
    },
