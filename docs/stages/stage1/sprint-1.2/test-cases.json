{
  "$schema": "Phase 1 - Sprint 1.2 Test Cases",
  "sprint": "1.2",
  "description": "Tests for Jobs CRUD + start/complete + Dashboard + Frontend pages",
  "test_cases": [
    {
      "id": "TC-INT-08-01",
      "task": "INT-08",
      "title": "Modèle Job - création et migration",
      "type": "integration",
      "preconditions": ["Tables user et client existent", "Alembic configuré"],
      "steps": [
        "Créer models/job.py avec Job, JobStatus, Priority",
        "Importer dans models/__init__.py",
        "alembic revision --autogenerate -m \"add job table\"",
        "alembic upgrade head",
        "Vérifier la table job et ses indexes"
      ],
      "expected_result": {
        "table_exists": true,
        "columns": [
          "id",
          "client_id",
          "technician_id",
          "title",
          "description",
          "status",
          "priority",
          "scheduled_date",
          "scheduled_start_time",
          "scheduled_end_time",
          "started_at",
          "completed_at",
          "observations",
          "created_at",
          "updated_at"
        ],
        "indexes": ["idx_job_client", "idx_job_technician", "idx_job_status", "idx_job_scheduled_date"],
        "fk_client": "ON DELETE CASCADE",
        "fk_technician": "ON DELETE SET NULL",
        "status_default": "planifié",
        "priority_default": "normale"
      },
      "actual_result": {
        "table_exists": true,
        "columns": [
          "id",
          "client_id",
          "technician_id",
          "title",
          "description",
          "status",
          "priority",
          "scheduled_date",
          "scheduled_start_time",
          "scheduled_end_time",
          "started_at",
          "completed_at",
          "observations",
          "created_at",
          "updated_at"
        ],
        "indexes": [
          "ix_job_client_id",
          "ix_job_technician_id",
          "ix_job_status",
          "ix_job_scheduled_date",
          "ix_job_priority"
        ],
        "fk_client": "ON DELETE CASCADE (défini dans le modèle, effectif en PostgreSQL)",
        "fk_technician": "ON DELETE SET NULL (défini dans le modèle, effectif en PostgreSQL)",
        "status_default": "planifié",
        "priority_default": "normale",
        "forward_relations": ["checklist_items", "photos", "materials", "review"],
        "notes": "Migration 7e7c3408ecfb appliquée. SQLite ne supporte pas ALTER CONSTRAINT donc les ondelete restent côté ORM. Forward relationships ajoutées pour ChecklistItem, JobPhoto, Material, Review."
      }
    },
    {
      "id": "TC-INT-09-01",
      "task": "INT-09",
      "title": "POST /jobs - création avec seed checklist",
      "type": "api",
      "preconditions": ["Client avec id=1 existe dans la base", "Utilisateur connecté (technicien)"],
      "steps": [
        "POST /api/v1/jobs",
        "Header: Authorization: Bearer <token>",
        "Body: { \"client_id\": 1, \"title\": \"Panne clim salon\", \"scheduled_date\": \"2026-05-15\", \"priority\": \"haute\" }"
      ],
      "expected_result": {
        "status_code": 201,
        "body": {
          "id": "int",
          "title": "Panne clim salon",
          "status": "planifié",
          "priority": "haute",
          "client": { "id": 1, "full_name": "string" },
          "checklist_items": "array of 5 items (3 pre + 2 post)",
          "checklist_items[0].checked": false
        }
      },
      "actual_result": {
        "status_code": 201,
        "body.id": "int (job créé)",
        "body.status": "planifié",
        "body.client.full_name": "Client Test",
        "seed_checklist": "3 items pré + 2 items post créés automatiquement"
      }
    },
