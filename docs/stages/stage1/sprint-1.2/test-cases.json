        "body.items": "array",
        "body.items[0].status": "planifié",
        "body.items[0].client": { "id": "int", "full_name": "string" },
        "body.items[0].technician": { "id": "int", "full_name": "string" }
      },
      "actual_result": {
        "status_code": 200,
        "body.items": "filtrés par status",
        "body.total": ">= 1"
      }
    },
