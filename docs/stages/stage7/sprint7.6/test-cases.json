    {
      "id": "TC-INT-111-01",
      "task": "INT-111",
      "title": "VPS - accès sécurisé par clé SSH",
      "type": "security",
      "preconditions": [
        "VPS provisionné",
        "Clé SSH configurée"
      ],
      "steps": [
        "ssh user@vps (avec clé) → doit fonctionner",
        "ssh user@vps -o PreferredAuthentications=password → doit échouer",
        "ssh root@vps → doit échouer",
        "sudo ufw status"
      ],
      "expected_result": {
        "acces_par_cle": "ok",
        "acces_par_mot_de_passe": "refusé",
        "acces_root_direct": "refusé",
        "ufw_actif": "true",
        "ports_ouverts": [
          22,
          80,
          443
        ],
        "fail2ban_actif": "true"
      },
      "actual_result": null,
      "legacy_id": "TC-INT-85-01"
    },
