    {
      "id": "TC-INT-42-01",
      "task": "INT-42",
      "title": "Navigation contextuelle - Dashboard → Job → Inspection",
      "type": "e2e",
      "preconditions": ["Jobs aujourd'hui", "Utilisateur connecté"],
      "steps": [
