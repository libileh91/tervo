    {
      "id": "TC-INT-39-03",
      "task": "INT-39",
      "title": "États - Error state avec bouton Réessayer",
      "type": "e2e",
      "preconditions": ["Backend indisponible (arrêter le serveur)"],
      "steps": ["Naviguer vers Dashboard", "Observer l'état d'erreur"],
      "expected_result": {
        "message_erreur": "visible et compréhensible",
        "bouton_reessayer": "visible et cliquable (appelle refetch())"
      },
      "actual_result": {
        "dashboard": "✅ Message severity=error + Bouton 'Réessayer' avec refetch()",
        "jobs": "✅ Message severity=error + Bouton 'Réessayer' avec refetch()",
        "clients": "✅ Message severity=error + Bouton 'Réessayer' avec refetch()",
        "job_detail": "✅ Message severity=error + Bouton 'Réessayer' avec refetch() (ajouté)",
        "client_detail": "✅ Message severity=error + Bouton 'Réessayer' avec refetchClient() (ajouté)",
        "client_detail_jobs": "✅ Message severity=warn + Bouton 'Réessayer' avec refetchJobs() (ajouté)",
        "inspection": "✅ Message severity=error + Bouton 'Réessayer' avec refetch() (ajouté)",
        "profile": "✅ icône + 'Impossible de charger le profil' + Bouton 'Réessayer' avec auth.fetchUser() (ajouté)",
        "review": "✅ Message + Bouton 'Réessayer' avec loadReviewData() (ajouté)"
      }
    },
