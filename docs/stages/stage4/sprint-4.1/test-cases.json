{
  "$schema": "Phase 4 - Sprint 4.1 Test Cases",
  "sprint": "4.1",
  "description": "Tests for responsive mobile, states management, transitions, quick client creation, navigation",
  "test_cases": [
    {
      "id": "TC-INT-38-01",
      "task": "INT-38",
      "title": "Responsive - layout mobile adapté",
      "type": "e2e",
      "preconditions": ["Application lancée"],
      "steps": [
        "Ouvrir l'app en viewport 375px (iPhone SE)",
        "Ouvrir l'app en viewport 430px (Galaxy S22)",
        "Vérifier les breakpoints"
      ],
      "expected_result": {
        "bottom_nav_fixe": "true (visible et collé en bas)",
        "safe_area_iphone": "padding-bottom: env(safe-area-inset-bottom)",
        "boutons_full_width": "true (classe PrimeVue fluid)",
        "pas_de_scroll_horizontal": "true",
        "font_size_min_16px": "true (pas de zoom automatique iOS)"
      },
      "actual_result": {
        "bottom_nav_fixe": "✅ BottomNav: position: fixed; bottom: 0; left: 0; right: 0; height: 60px",
        "safe_area_iphone": "✅ BottomNav: padding-bottom: env(safe-area-inset-bottom, 0) ; App.vue app-content: padding-bottom: calc(60px + 12px + env(safe-area-inset-bottom, 0px)) ; index.html: viewport-fit=cover",
        "boutons_full_width": "✅ fluid ajouté sur tous les boutons avec label (Dashboard, Jobs, Clients, JobDetail, ClientDetail, Inspection, Profile, Login, Review) ; dialog-actions passés en flex-direction: column",
        "pas_de_scroll_horizontal": "✅ box-sizing: border-box global sur *, *::before, *::after ; tous les champs en width: 100% via fluid",
        "font_size_min_16px": "✅ Règle CSS globale : input, textarea, select, .p-inputtext, .p-password input, .p-datepicker input, .p-select-label, .p-inputtextarea { font-size: 16px !important; }"
      }
    },
    {
