    {
      "id": "TC-INT-41-01",
      "task": "INT-41",
      "title": "Création rapide client + job - workflow complet",
      "type": "e2e",
      "preconditions": ["Client inexistant", "Utilisateur connecté"],
      "steps": [
        "Naviguer vers formulaire nouveau job",
        "Chercher client inexistant → 'Aucun résultat'",
        "Cliquer '➕ Nouveau client'",
        "Remplir nom + téléphone + adresse",
        "Remplir titre job + date",
        "Soumettre"
      ],
      "expected_result": {
        "client_créé": "true (requête POST /clients réussie)",
        "job_créé": "true (requête POST /jobs réussie)",
