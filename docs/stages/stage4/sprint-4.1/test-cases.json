        "noms_de_route_utilises": "true (pas de paths en dur)"
      },
      "actual_result": {
        "dashboard_prochain_job": "✅ next-job-card @click="router.push({ name: 'JobDetail', params: { id } })" avec class clickable-card",
        "dashboard_job_en_cours": "✅ in-progress-card @click="router.push({ name: 'JobDetail', params: { id } })" avec class clickable-card",
        "dashboard_demarrer_stop": "✅ @click.stop sur '▶ Démarrer' pour éviter propagation",
        "jobdetail_checklist": "✅ { name: 'Inspection', params: { id } } — déjà fait",
        "inspection_retour": "✅ @click="router.push({ name: 'JobDetail', params: { id: jobId } })" (remplace router.back())",
