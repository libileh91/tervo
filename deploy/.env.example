# Copy to deploy/.env locally, chmod 600; never commit the real file.
# Always pass --env-file explicitly. Empty secrets intentionally fail validation.
TERVO_IMAGE_TAG=
TERVO_VCS_REF=
TERVO_DB_NAME=tervo_db
TERVO_DB_USER=tervo_app
# Use single quotes for passwords containing $, # or spaces (Compose dotenv).
# Generate privately; do not paste passwords or a resolved config into chat.
TERVO_DB_PASSWORD=
SECRET_KEY=
FRONTEND_ORIGIN=https://tervoapp.com
VITE_API_BASE_URL=https://api.tervoapp.com/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
