# Reference source, not a dynamic import. INT-111 copied it to /etc/caddy/Caddyfile;
# editing this file alone does not change the running proxy. Revalidate then reload.
# Loading this profile enables automatic HTTPS (frontend/API + HTTP->HTTPS redirects).
# Hostnames are the confirmed public names; keep ports on 127.0.0.1 and h1/h2 only.
{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2
	}
}

tervoapp.com {
	reverse_proxy 127.0.0.1:3000
}

api.tervoapp.com {
	reverse_proxy 127.0.0.1:8000
}
