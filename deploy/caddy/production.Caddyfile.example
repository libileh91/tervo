# INACTIVE EXAMPLE ONLY. Do not load/import before INT-111 and explicit go-ahead.
# Hostnames are examples, not evidence of certificate issuance or validation.
# Loading this profile would enable automatic HTTPS; INT-131 never runs it.
{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2
	}
}

tervoapp.com {
	reverse_proxy 127.0.0.1:3000
}

api.tervoapp.com {
	reverse_proxy 127.0.0.1:8000
}
